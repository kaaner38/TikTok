# Claude
ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_MODEL=claude-sonnet-5-5
MIN_VIRALITY=7

# Posting (Blotato, auditierte TikTok-App)
DRAFT_MODE=true
BLOTATO_API_KEY=
BLOTATO_TIKTOK_ACCOUNT_ID=
BLOTATO_BASE_URL=https://backend.blotato.com/v2
# Öffentliche URL, unter der output/clips/ erreichbar ist (z. B. S3/R2-Bucket-Sync). Leer = Base64-Upload
PUBLIC_MEDIA_BASE_URL=

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Twitch (optional: Top-Clips-Signal)
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# TikTok Display API (stats.py: video.list)
TIKTOK_ACCESS_TOKEN=

# Betrieb
TIMEZONE=Europe/Berlin
POST_TIMES=12:00,16:00,19:00,21:30
MAX_PARALLEL_RECORDINGS=3
MAX_CLIPS_PER_STREAMER_PER_DAY=2
RETENTION_HOURS=48
WHISPER_MODEL=large-v3-turbo
WHISPER_DEVICE=auto
CHUNK_SECONDS=600
VOD_MAX_SECONDS=10800
